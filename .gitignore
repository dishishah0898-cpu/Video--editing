# Rendered video outputs and work dirs (large; regenerated by `hyperframes render`)
projects/*/*.mp4

# Graded source plates are NOT render outputs: they are cut from footage that
# only ever existed as a chat upload, so `render` cannot rebuild them.
!projects/*/base.mp4

# Delivered reels: the compressed cut that actually gets posted.
!projects/*/*-reel.mp4
projects/*/renders/
projects/*/work-*/
projects/*/snapshots/
projects/*/.hyperframes/
projects/run-reel/seg/
projects/run-reel/frames/
projects/*/frames/

# Scratch/staging dirs for media prep (intermediate; not part of a HyperFrames project)
projects/run-reel/
projects/bike-reel/
